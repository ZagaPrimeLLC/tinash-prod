[Unit]
Description=Tinash Homecare phone receptionist
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -m receptionist.server
Restart=always
RestartSec=5
# Keep the Pi responsive for the speech models
Nice=-5
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__APP_DIR__/data

[Install]
WantedBy=multi-user.target
