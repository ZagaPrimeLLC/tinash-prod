# Copy to .env and fill in. Never commit .env.

# --- Safety switch -------------------------------------------------------
# true  = print the lead instead of sending it to the website (use while testing)
# false = send every call's details to the website's /api/inquiry (goes into the CRM
#         and the office gets the usual email)
DRY_RUN=true
INQUIRY_URL=https://tinashhomecareservices.com/api/inquiry

# --- Phone (Telnyx) -----------------------------------------------------------
# A long random secret. It is part of the webhook and audio-stream addresses so
# nobody else can use the assistant. Create one with:  openssl rand -hex 24
CALL_TOKEN=
# Public WebSocket address of this machine (the Cloudflare Tunnel hostname) + /ws
PUBLIC_WS_URL=wss://voice.tinashhomecareservices.com/ws
# Optional but recommended: lets the assistant hang up cleanly through the Telnyx API.
# Telnyx portal > Account settings > API Keys.
TELNYX_API_KEY=
# A Raspberry Pi handles one call at a time; extra callers hear a short "lines busy" message.
MAX_CONCURRENT_CALLS=1
MAX_CALL_SECONDS=900

# --- Local AI models -------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=120
# Speech recognition. base.en answers about 3x faster than small.en on a Pi 5;
# small.en is a bit more accurate with names. Both are downloaded by the installers.
WHISPER_MODEL=models/whisper/base.en
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
PIPER_VOICE=en_US-amy-medium
PIPER_DIR=models/piper

# --- Server -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
DATA_DIR=data
TRANSCRIPT_RETENTION_DAYS=30
# INFO keeps what callers say out of the system log. DEBUG is for troubleshooting only.
LOG_LEVEL=INFO
# Testing only: save every speech segment the recognizer hears (as WAV) into data/<dir>
STT_DEBUG_DIR=
