# Cloudflare Workers static assets headers (OpenNext copies public/ into
# .open-next/assets, which wrangler.jsonc serves; these files never reach the
# worker, so next.config headers() would not apply to them).
# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
#
# /media and /brand files are long-lived: give a changed file a new name
# (e.g. logo-v2.webp) rather than overwriting it in place.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable
