# ── Supabase (team CRM, careers, contact/booking, chatbot leads) ───────────
# All three are public by design: the anon key ships to the browser and Row
# Level Security is the lock. Leave them unset and the public site still
# builds and runs (forms fall back to /api/inquiry; the CRM shows "not connected").
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_SUPABASE_SCHEMA=proj_tinash

# Canonical site URL (sitemap, job links, feed endpoint shown in Settings).
# Defaults to https://tinashhomecareservices.com when unset.
NEXT_PUBLIC_SITE_URL=

# ── Optional: email the office when a lead arrives (Resend) ────────────────
RESEND_API_KEY=
INQUIRY_TO=
INQUIRY_FROM=
